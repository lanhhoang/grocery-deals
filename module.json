{
  "id": "grocery-deals",
  "group": "Shopping",
  "name": "Daily Grocery Deals",
  "description": "Daily digest of the best grocery deals near you, powered by Flipp",
  "version": "1.0.0",
  "author": "ARI Hackathon",
  "icon": "ShoppingCart",
  "enabled": true,
  "fullscreen": false,
  "menuPriority": 30,
  "permissions": {
    "database": true,
    "api": true,
    "dashboard": true
