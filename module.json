      "label": "Daily Grocery Deals",
      "icon": "ShoppingCart",
      "sidebarPosition": "main"
    }
  ],
  "dependencies": {
    "modules": [],
    "coreFeatures": []
  },
  "database": {
    "tables": ["grocery_keywords", "grocery_saved_deals", "grocery_deals_cache"]
  },
  "npmDependencies": {},
  "dashboard": {
    "widgets": true,
    "widgetComponents": ["./components/dashboard-widget.tsx"]
  },
  "submenu": {
    "component": "./components/sidebar-submenu.tsx"
